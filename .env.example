# IT Dashboard Agent Configuration

# Dashboard URL (required)
DASHBOARD_URL=https://it-dashboard-gray.vercel.app

# Agent API Key (required - get this from the admin panel)
AGENT_API_KEY=agt_your_api_key_here

# Agent name (optional - override what's configured in dashboard)
AGENT_NAME=Office Network Agent

# Heartbeat interval in seconds (default: 60)
HEARTBEAT_INTERVAL=60

# Status check interval in seconds (default: 30)
STATUS_CHECK_INTERVAL=30

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info
