{
  "name": "it-dashboard-agent",
  "version": "1.0.0",
  "description": "Local network monitoring agent for IT Dashboard",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run copy-static",
    "copy-static": "node -e \"const fs=require('fs');const path=require('path');fs.cpSync('src/ui/public','dist/ui/public',{recursive:true})\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node-ssdp": "^4.0.5",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "express": "^5.2.1",
    "net-snmp": "^3.26.1",
    "node-ssdp": "^4.0.1",
    "oui": "^13.1.3",
    "oui-data": "^1.1.516",
    "socket.io": "^4.8.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
